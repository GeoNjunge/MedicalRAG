# Backend environment variables
# Copy to .env in the repo root (or apps/api/.env) and fill in values.

APP_ENV=dev

# Public URLs used for CORS and health/docs links
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200
# Optional comma-separated override, e.g. https://app.example.com,https://www.example.com
# CORS_ORIGINS=

# Production example:
# APP_ENV=production
# BACKEND_URL=https://your-backend.onrender.com
# FRONTEND_URL=https://your-frontend.onrender.com

# PostgreSQL example (asyncpg URLs are normalized to psycopg at runtime):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/medicalrag
DATABASE_URL=sqlite:///docs.db
S3_BUCKET_URL=
S3_BUCKET_NAME=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
S3_REGION_NAME=
OLLAMA_URL=http://localhost:11434

# Required when APP_ENV=production
GROQ_API_KEY=
GROQ_MODEL=

# Required when APP_ENV=production (shared secret for API clients)
API_KEY=

# Redis for job events and dev worker queue (defaults to localhost)
REDIS_URL=redis://localhost:6379/0
