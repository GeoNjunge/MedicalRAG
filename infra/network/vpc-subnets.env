# Simulated VPC layout for local Docker Compose (see docker-compose.yml networks).
# These values document intent; Compose assigns bridge subnets automatically unless pinned.

# Tier          Compose network     Typical CIDR (example)   Services
# ---------------------------------------------------------------------------
# edge          vpc-edge            172.28.0.0/24            loadbalancer (nginx)
# application   vpc-app             172.28.1.0/24            api (FastAPI / uvicorn)
# data          vpc-data            172.28.2.0/24            redis, postgres (optional)
# workers       vpc-workers         172.28.3.0/24            rq-worker

COMPOSE_EDGE_NETWORK=vpc-edge
COMPOSE_APP_NETWORK=vpc-app
COMPOSE_DATA_NETWORK=vpc-data
COMPOSE_WORKER_NETWORK=vpc-workers
